---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <span slot="title">Home</span>

  <section class="container">
    <h1>Building reliable digital systems.</h1>
    <p class="muted">
      Web development, systems setup, networking, DevOps, and IT as a Service.
    </p>
    <a href="/services">View Services →</a>
  </section>

  <section class="container grid grid-3">
    <div>
      <h3>Web Development</h3>
      <p>Fast, accessible, and maintainable websites and systems.</p>
    </div>
    <div>
      <h3>Systems & DevOps</h3>
      <p>Linux servers, automation, CI/CD, and infrastructure.</p>
    </div>
    <div>
      <h3>IT as a Service</h3>
      <p>Reliable IT support for organizations that outsource.</p>
    </div>
  </section>
</BaseLayout>
