---
import { getCollection } from 'astro:content';
import "../styles/global.css";

// Get all musings posts
const allMusings = await getCollection('musings', ({ data }) => {
  return !data.draft; // Only include non-draft posts
});

// Sort by date (newest first)
const sortedMusings = allMusings.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Prepare musings data for client-side use
const musingsData = sortedMusings.map(post => ({
  slug: post.slug,
  data: {
    title: post.data.title,
    description: post.data.description || '',
    author: post.data.author || 'John Awotwi',
    date: post.data.date,
    updatedDate: post.data.updatedDate,
    category: post.data.category || '',
    tags: Array.isArray(post.data.tags) ? post.data.tags : [],
    excerpt: post.data.excerpt || '',
  }
}));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>John Awotwi</title>
</head>

<body>
  <main class="container grid grid-2">

    <!-- LEFT COLUMN -->
    <aside>
      <h1 style="font-size:3rem; margin-bottom:0.5rem;">John Awotwi</h1>
      <p style="font-size:1.1rem;">
        Senior Technical Officer at CSIR-INSTI
      </p>

      <p class="muted" style="margin-top:1.5rem;">
        Community Development · IT Specialist · Information Security
      </p>

      <p style="margin-top:1.5rem; max-width:420px;">
        I transform research outputs into practical software, systems,
        and communication tools for national development. I am passionate
        about technology, people, and building sustainable communities.
      </p>

      <!-- SECTION NAV -->
      <nav style="margin-top:3rem;">
        <div><small>01</small> — <a href="#" data-section="projects" class="nav-link active">PROJECTS</a></div>
        <div><small>02</small> — <a href="#" data-section="services" class="nav-link">SERVICES</a></div>
        <div><small>03</small> — <a href="#" data-section="programs" class="nav-link">PROGRAMS</a></div>
        <div><small>04</small> — <a href="#" data-section="musings" class="nav-link">My MUSINGS</a></div>
      </nav>

      <!-- SOCIALS -->
      <div class="social-links" style="margin-top:4rem;">
        <img src="/moi.png" alt="John Awotwi" width="42" height="42" />
        <a href="https://twitter.com/JeanHuit" target="_blank">Twitter</a>
        <a href="https://github.com/JeanHuit" target="_blank">GitHub</a>
        <a href="https://www.linkedin.com/in/johnawotwi/" target="_blank">LinkedIn</a>
      </div>
    </aside>

    <!-- RIGHT COLUMN -->
    <section id="content-area">
      <!-- PROJECTS SECTION -->
      <div id="projects-content" class="section-content active">
        <div class="card">
          <small>TYPESCRIPT / SYSTEMS</small>
          <h3>HPC Cluster Deployment</h3>
          <p class="muted">
            Multi-node compute cluster for scientific simulations and parallel workloads.
          </p>
        </div>

        <div class="card">
          <small>WEB / SYSTEMS</small>
          <h3>Institutional Web Platform</h3>
          <p class="muted">
            Internal research management system with dashboards and reporting.
          </p>
        </div>

        <div class="card">
          <small>DEVOPS</small>
          <h3>CI/CD & Infrastructure Automation</h3>
          <p class="muted">
            Automated deployments, containerized services, and system monitoring.
          </p>
        </div>
      </div>

      <!-- SERVICES SECTION -->
      <div id="services-content" class="section-content">
        <div class="card">
          <small>SERVICES</small>
          <h3>Web Development</h3>
          <p class="muted">
            Websites, dashboards, and internal tools built for performance and clarity.
          </p>
        </div>

        <div class="card">
          <small>SERVICES</small>
          <h3>Systems Setup</h3>
          <p class="muted">
            Linux servers, compute environments, and secure deployments.
          </p>
        </div>

        <div class="card">
          <small>SERVICES</small>
          <h3>Networking</h3>
          <p class="muted">
            Local and remote network design, setup, and maintenance.
          </p>
        </div>

        <div class="card">
          <small>SERVICES</small>
          <h3>DevOps</h3>
          <p class="muted">
            CI/CD pipelines, containerization, and automated deployments.
          </p>
        </div>

        <div class="card">
          <small>SERVICES</small>
          <h3>IT as a Service</h3>
          <p class="muted">
            Ongoing IT support and system management for organizations.
          </p>
        </div>
      </div>

      <!-- PROGRAMS SECTION -->
      <div id="programs-content" class="section-content">
        <div class="card">
          <small>EVENT / 2023</small>
          <h3>Google Developer Group (GDG) Leadership</h3>
          <p class="muted">
            Organized and led technology community events and workshops in Ghana.
          </p>
        </div>

        <div class="card">
          <small>PROGRAM / 2022</small>
          <h3>CSIR-INSTI Tech Initiative</h3>
          <p class="muted">
            Led digital transformation projects for research communication systems.
          </p>
        </div>

        <div class="card">
          <small>WORKSHOP / 2021</small>
          <h3>Community Tech Bootcamp</h3>
          <p class="muted">
            Facilitated hands-on training for local developers and researchers.
          </p>
        </div>
      </div>

      <!-- MUSINGS SECTION -->
      <div id="musings-content" class="section-content">
        <h2>Musings</h2>
        <p class="muted">Thoughts, ideas, and reflections on technology, life, and everything in between.</p>

        <!-- Dynamic musings content will be inserted here -->
        <div id="musings-posts-list" class="posts-list">
          <!-- Posts will be loaded dynamically -->
        </div>

        <!-- Hidden script tag to hold musings data -->
        <script id="musings-data" type="application/json" set:html={JSON.stringify(musingsData)}></script>
      </div>
    </section>
  </main>

  <script>
    // Section switching functionality
    document.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();

        const targetSection = this.getAttribute('data-section');

        // Update active nav link
        document.querySelectorAll('.nav-link').forEach(nav => {
          nav.classList.remove('active');
        });
        this.classList.add('active');

        // Show target content section
        document.querySelectorAll('.section-content').forEach(section => {
          section.classList.remove('active');
        });
        document.getElementById(`${targetSection}-content`).classList.add('active');

        // Special handling for musings section to load content
        if (targetSection === 'musings') {
          loadMusingsContent();
        }
      });
    });

    // Load musings content dynamically
    function loadMusingsContent() {
      try {
        console.log('Attempting to load musings content...');

        // Get the musings data from the embedded script tag
        const musingsDataElement = document.getElementById('musings-data');
        console.log('Data element found:', musingsDataElement);

        if (!musingsDataElement) {
          throw new Error('Musings data element not found');
        }

        console.log('Raw data content:', musingsDataElement.textContent);

        const musings = JSON.parse(musingsDataElement.textContent);
        console.log('Parsed musings data:', musings);

        const postsContainer = document.getElementById('musings-posts-list');
        if (!postsContainer) {
          throw new Error('Posts container not found');
        }

        postsContainer.innerHTML = '';

        if (!musings || musings.length === 0) {
          postsContainer.innerHTML = '<p>No musings posts available.</p>';
          return;
        }

        musings.forEach(post => {
          const postElement = document.createElement('article');
          postElement.className = 'post-item';

          // Create the tag HTML elements
          let tagsHtml = '';
          if (post.data.tags && post.data.tags.length > 0) {
            tagsHtml = '<div class="tags">';
            post.data.tags.forEach(tag => {
              tagsHtml += `<span class="tag">${tag}</span>`;
            });
            tagsHtml += '</div>';
          }

          // Convert date string back to Date object if needed
          const postDate = typeof post.data.date === 'string' ? new Date(post.data.date) : post.data.date;
          const dateISOString = postDate.toISOString();
          const dateLocaleString = postDate.toLocaleDateString();

          // Handle updatedDate if it exists
          let updatedHtml = '';
          if (post.data.updatedDate) {
            const updatedDate = typeof post.data.updatedDate === 'string' ? new Date(post.data.updatedDate) : post.data.updatedDate;
            updatedHtml = `<time datetime="${updatedDate.toISOString()}">(Updated: ${updatedDate.toLocaleDateString()})</time>`;
          }

          postElement.innerHTML = `
            <div class="card">
              <h3><a href="/musings/${post.slug}" style="color: var(--text);">${post.data.title}</a></h3>
              <p class="muted">${post.data.description || post.data.excerpt || ''}</p>
              <div class="post-meta">
                <span>By ${post.data.author || 'John Awotwi'}</span>
                <time datetime="${dateISOString}">${dateLocaleString}</time>
                ${updatedHtml}
                ${post.data.category ? `<span class="category">${post.data.category}</span>` : ''}
                ${tagsHtml}
              </div>
            </div>
          `;
          postsContainer.appendChild(postElement);
        });

        console.log('Musings content loaded successfully');
      } catch (error) {
        console.error('Error loading musings:', error);
        const postsContainer = document.getElementById('musings-posts-list');
        if (postsContainer) {
          postsContainer.innerHTML = '<p>Unable to load musings at this time. Error: ' + error.message + '</p>';
        }
      }
    }

  </script>
</body>
</html>
