---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import Card from '../components/Card.astro';
import SocialLinks from '../components/SocialLinks.astro';
import SectionNav from '../components/SectionNav.astro';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';
import ServicesSection from '../components/ServicesSection.astro';
import GitHubStats from '../components/GitHubStats.astro';

// Get all musings posts
const allMusings = await getCollection('musings', ({ data }) => {
  return !data.draft;
});

// Sort by date (newest first)
const sortedMusings = allMusings.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Prepare musings data for client-side use
const musingsData = sortedMusings.map(post => ({
  slug: post.slug,
  data: {
    title: post.data.title,
    description: post.data.description || post.data.excerpt || '',
    author: post.data.author || 'John Awotwi',
    date: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    category: post.data.category || '',
    tags: post.data.tags || [],
    excerpt: post.data.excerpt || '',
  }
}));

// Get projects (services handled by ServicesSection component)
const projects = await getCollection('projects');
---

<BaseLayout title="John Awotwi">
  <SEO
    title="John Awotwi - Senior Technical Officer"
    description="Systems engineer and DevOps specialist with 8+ years of experience designing, deploying, and maintaining production-grade web and network infrastructure."
    type="website"
  />
  
  <main class="container grid grid-2" id="main-content">
    <!-- LEFT COLUMN -->
    <aside>
      <div class="profile-header">
        <img src="/me.jpg" alt="John Awotwi" class="profile-image" />
        <h1>John Awotwi</h1>
        <p class="title">
          Senior Technical Officer at CSIR-INSTI
        </p>

        <p class="tagline muted">
          Community Development · IT Specialist · Information Security
        </p>

        <!-- GITHUB STATS -->
        <div class="mt-4">
          <GitHubStats />
        </div>
      </div>

      <!-- SECTION NAV -->
      <div style="margin-top: 2rem;">
        <SectionNav />
      </div>

      <!-- SOCIALS -->
      <div class="mt-4">
        <SocialLinks />
      </div>
    </aside>

    <!-- RIGHT COLUMN -->
    <section id="content-area">
      <!-- PROJECTS SECTION -->
      <div id="projects-content" class="section-content active" role="tabpanel" aria-labelledby="projects-tab">
        {projects.map((project) => (
          <Card
            title={project.data.title}
            description={project.data.description}
            category={project.data.category}
            tags={project.data.tags}
          />
        ))}
      </div>

      <!-- SERVICES SECTION -->
      <div id="services-content" class="section-content" role="tabpanel" aria-labelledby="services-tab">
        <!-- 
          Change cardStyle to try different designs:
          - 'default' - Simple cards
          - 'flipping' - 3D flip cards on hover
          - 'gradient' - Animated gradient border
          - 'minimal' - Clean minimal design
          - 'expandable' - Expands on hover
        -->
        <ServicesSection cardStyle="gradient" />
      </div>

      <!-- RESUME SECTION -->
      <div id="resume-content" class="section-content" role="tabpanel" aria-labelledby="resume-tab">
        <section class="resume-section">
          <h2>Executive Profile</h2>
          <p>Systems engineer and DevOps specialist with 8+ years of experience designing, deploying, and maintaining production-grade web and network infrastructure. Lead developer of multiple institutional platforms and currently architecting AI focused systems. Experienced in Linux server administration, CI/CD automation, database systems.</p>
        </section>

        <section class="resume-section">
          <h2>Technical Expertise</h2>
          <div class="resume-grid">
            <div>
              <h3>Programming & Development</h3>
              <ul>
                <li>PHP, Python</li>
                <li>MariaDB, MySQL</li>
                <li>HTML, CSS, JavaScript</li>
              </ul>
            </div>
            <div>
              <h3>DevOps & Infrastructure</h3>
              <ul>
                <li>Linux Server Administration</li>
                <li>Git, CI/CD Pipelines</li>
                <li>Proxmox, Docker</li>
                <li>Infrastructure Monitoring</li>
              </ul>
            </div>
            <div>
              <h3>Cloud & Networking</h3>
              <ul>
                <li>AWS</li>
                <li>LAN/WAN, Routers, Switches</li>
                <li>System Hardening</li>
              </ul>
            </div>
          </div>
        </section>

        <section class="resume-section">
          <h2>Experience</h2>
          <div class="job">
            <h3>Senior Technical Officer</h3>
            <p class="company">Institute for Scientific & Technological Information, Accra</p>
            <p class="dates">Mar 2019 - Present</p>
            <ul>
              <li>Architected and deployed 6+ institutional web platforms serving research and agricultural data systems</li>
              <li>Report Management System: Designed and managed CI/CD pipelines for multi-project deployments with source code management via GitHub</li>
              <li>Administer Linux-based production servers (Proxmox)</li>
              <li>Provide infrastructure monitoring, backup strategies, and system hardening</li>
            </ul>
          </div>
          <div class="job">
            <h3>IT Officer</h3>
            <p class="company">La Dade-Kotopon Municipal Assembly, La</p>
            <p class="dates">May 2015 - Mar 2019</p>
            <ul>
              <li>Managed municipal network infrastructure (LAN/WAN, routers, switches)</li>
              <li>Provided system troubleshooting across multi-user environments</li>
              <li>Implemented network maintenance and hardware lifecycle planning</li>
            </ul>
          </div>
        </section>

        <section class="resume-section">
          <h2>Projects</h2>
          <ul class="project-list">
            <li><strong>CSIRSpace</strong> — Institutional digital repository with optimized database, server configuration, and reliability management</li>
            <li><strong>AgHub</strong> — Full-stack agricultural data platform deployed for bandwidth-constrained environments</li>
            <li><strong>CSIR eLearning</strong> — Multi-user eLearning system with CI/CD workflows, performance tuning, and server administration</li>
          </ul>
        </section>

        <section class="resume-section">
          <h2>Education</h2>
          <div class="education-item">
            <h3>MSc. IT</h3>
            <p>Kwame Nkrumah University of Science & Technology</p>
            <p class="dates">Nov 2025</p>
          </div>
          <div class="education-item">
            <h3>BSc. IT</h3>
            <p>Ghana Technology University College, Tesano</p>
            <p class="dates">Nov 2013</p>
          </div>
        </section>

        <section class="resume-section">
          <h2>Languages</h2>
          <p>English</p>
        </section>
      </div>

      <!-- MUSINGS SECTION -->
      <div id="musings-content" class="section-content" role="tabpanel" aria-labelledby="musings-tab">
        <h2>Musings</h2>
        <p class="muted">Thoughts, ideas, and reflections on technology, life, and everything in between.</p>

        <!-- Search component -->
        <Search posts={musingsData} />

        <!-- Dynamic musings content -->
        <div id="musings-posts-list" class="posts-list">
          {sortedMusings.map((post) => {
            const postDate = post.data.pubDate;
            const dateLocaleString = postDate.toLocaleDateString();
            const dateISOString = postDate.toISOString();
            
            return (
              <article class="post-item">
                <div class="card">
                  <h3>
                    <a href={`/musings/${post.slug}`} style="color: var(--text);">
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="muted">
                    {post.data.description || post.data.excerpt || ''}
                  </p>
                  <div class="post-meta">
                    <span>By {post.data.author || 'John Awotwi'}</span>
                    <time datetime={dateISOString}>{dateLocaleString}</time>
                    {post.data.updatedDate && (
                      <time datetime={post.data.updatedDate.toISOString()}>
                        (Updated: {post.data.updatedDate.toLocaleDateString()})
                      </time>
                    )}
                  </div>
                  {(post.data.category || post.data.tags?.length) && (
                    <div class="mt-2">
                      {post.data.category && (
                        <span class="category">{post.data.category}</span>
                      )}
                      {post.data.tags?.length ? (
                        <div class="tags">
                          {post.data.tags.map((tag) => (
                            <span class="tag">{tag}</span>
                          ))}
                        </div>
                      ) : null}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>

  <script>
    // Section switching functionality with View Transitions
    document.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();

        const targetSection = this.getAttribute('data-section');

        // Update active nav link
        document.querySelectorAll('.nav-link').forEach(nav => {
          nav.classList.remove('active');
        });
        this.classList.add('active');

        // Show target content section with fade animation
        document.querySelectorAll('.section-content').forEach(section => {
          section.classList.remove('active');
          section.setAttribute('aria-hidden', 'true');
        });
        
        const targetContent = document.getElementById(`${targetSection}-content`);
        if (targetContent) {
          targetContent.classList.add('active');
          targetContent.setAttribute('aria-hidden', 'false');
          
          // Update URL without page reload
          const newUrl = targetSection === 'projects' 
            ? window.location.pathname 
            : `${window.location.pathname}?section=${targetSection}`;
          window.history.pushState({ section: targetSection }, '', newUrl);
        }

        // Special handling for musings section
        if (targetSection === 'musings') {
          const searchInput = document.getElementById('musing-search');
          if (searchInput) {
            (searchInput as HTMLInputElement).focus();
          }
        }
      });
    });

    // Handle browser back/forward navigation
    window.addEventListener('popstate', function(event) {
      const urlParams = new URLSearchParams(window.location.search);
      const section = urlParams.get('section') || 'projects';
      
      const targetLink = document.querySelector(`[data-section="${section}"]`);
      if (targetLink) {
        (targetLink as HTMLElement).click();
      }
    });

    // Check URL on page load for section
    document.addEventListener('DOMContentLoaded', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const section = urlParams.get('section');
      
      if (section) {
        const targetLink = document.querySelector(`[data-section="${section}"]`);
        if (targetLink) {
          (targetLink as HTMLElement).click();
        }
      }
    });
  </script>
</BaseLayout>

<style>
  /* Section-specific styles */
  .section-content {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  
  .section-content.active {
    opacity: 1;
  }
  
  .section-content[aria-hidden="true"] {
    display: none;
  }

  /* Resume section styles */
  .resume-section {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .resume-section:last-child {
    border-bottom: none;
  }

  .resume-section h2 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: var(--accent);
  }

  .resume-section h3 {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .resume-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .resume-grid ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .resume-grid li {
    padding: 0.25rem 0;
    font-size: 0.9rem;
  }

  .job, .education-item {
    margin-bottom: 1.5rem;
  }

  .job .company, .education-item p {
    margin: 0;
    font-size: 0.9rem;
  }

  .job .dates, .education-item .dates {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  .job ul {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
  }

  .job li {
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }

  .project-list {
    list-style: none;
    padding: 0;
  }

  .project-list li {
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }

  .project-list strong {
    color: var(--accent);
  }

  .section-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .rss-link:hover {
    color: var(--accent);
  }
</style>
