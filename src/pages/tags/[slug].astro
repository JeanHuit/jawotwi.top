---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import Card from '../../components/Card.astro';

export async function getStaticPaths() {
  const musings = await getCollection('musings', ({ data }) => !data.draft);
  
  // Collect all unique tags
  const tagMap = new Map<string, typeof musings>();
  
  musings.forEach((post) => {
    post.data.tags?.forEach((tag) => {
      // Create URL-safe slug: lowercase, replace spaces and special chars with hyphens
      const slug = tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      if (!tagMap.has(slug)) {
        tagMap.set(slug, []);
      }
      tagMap.get(slug)!.push(post);
    });
  });
  
  return Array.from(tagMap.entries()).map(([slug, posts]) => ({
    params: { slug },
    props: {
      tagName: slug.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' '),
      posts: posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tagName, posts } = Astro.props;
---

<BaseLayout title={`${tagName} - Musings`}>
  <SEO
    title={`${tagName} - Musings`}
    description={`Posts tagged with ${tagName} on John Awotwi's blog.`}
    type="website"
  />
  
  <main class="container" id="main-content">
    <div style="margin-bottom: 2rem;">
      <a href="/?section=musings" style="color: var(--accent); text-decoration: none;">
        ← Back to Musings
      </a>
    </div>
    
    <h1>
      <span class="category">{tagName}</span>
    </h1>
    <p class="muted">
      {posts.length} post{posts.length !== 1 ? 's' : ''} tagged with "{tagName}"
    </p>
    
    <div class="posts-list mt-4">
      {posts.map((post) => {
        const postDate = post.data.pubDate;
        const dateLocaleString = postDate.toLocaleDateString();
        const dateISOString = postDate.toISOString();
        
        return (
          <article class="post-item">
            <Card
              title={post.data.title}
              description={post.data.description || post.data.excerpt || ''}
              href={`/musings/${post.slug}`}
            >
              <div class="post-meta mt-2">
                <span>By {post.data.author || 'John Awotwi'}</span>
                <time datetime={dateISOString}>{dateLocaleString}</time>
              </div>
            </Card>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>
