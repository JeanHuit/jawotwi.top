---
import BaseLayout from "./BaseLayout.astro";
import SEO from "../components/SEO.astro";
import Icon from "../components/Icon.astro";

const {
  title,
  description,
  author,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  category,
  keywords,
  excerpt,
  readingTime
} = Astro.props;

const postDescription = description || excerpt || '';
const postKeywords = keywords || [];
const canonicalUrl = `https://jawotwi.top${Astro.url.pathname}`;

// Convert date to ISO string for meta tags
const formatDate = (date: Date | string | undefined): string | undefined => {
  if (!date) return undefined;
  return typeof date === 'string' ? date : date.toISOString();
};
---

<BaseLayout title={title}>
  <SEO
    title={title}
    description={postDescription}
    image={heroImage?.src}
    type="article"
    publishedTime={pubDate}
    modifiedTime={updatedDate}
    author={author || 'John Awotwi'}
    section={category}
    tags={tags}
    keywords={postKeywords}
    canonicalUrl={canonicalUrl}
  />
  
  <main class="container" id="main-content">
    <article class="card">
      <header>
        <h1>{title}</h1>
        <p class="muted">{postDescription}</p>
        <div class="post-meta">
          <span>By {author || 'John Awotwi'}</span>
          <time datetime={formatDate(pubDate)}>
            {typeof pubDate === 'string' ? new Date(pubDate).toLocaleDateString() : pubDate?.toLocaleDateString()}
          </time>
          {updatedDate && (
            <time datetime={formatDate(updatedDate)}>
              (Updated: {typeof updatedDate === 'string' ? new Date(updatedDate).toLocaleDateString() : updatedDate.toLocaleDateString()})
            </time>
          )}
          {readingTime && <span class="reading-time">~{readingTime} min read</span>}
        </div>
        
        {(category || tags?.length) && (
          <div class="mt-2">
            {category && <span class="category">{category}</span>}
            {tags?.length ? (
              <div class="tags">
                {tags.map((tag: string) => (
                  <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag">{tag}</a>
                ))}
              </div>
            ) : null}
          </div>
        )}
      </header>

      <div class="post-content">
        <slot />
      </div>

      <div class="social-sharing">
        <h3>Share this post</h3>
        <div class="social-sharing-buttons">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn twitter"
            aria-label="Share on Twitter"
          >
            <Icon name="twitter" size={18} />
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn linkedin"
            aria-label="Share on LinkedIn"
          >
            <Icon name="linkedin" size={18} />
          </a>
          <a
            href={`https://facebook.com/sharer.php?u=${encodeURIComponent(canonicalUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn facebook"
            aria-label="Share on Facebook"
          >
            <Icon name="facebook" size={18} />
          </a>
          <button
            class="share-btn copy"
            onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied!');"
            aria-label="Copy link"
          >
            <Icon name="copy" size={18} />
            Copy Link
          </button>
        </div>
      </div>

      <div class="post-navigation">
        <h3>More Musings</h3>
        <p>
          <a href="/" class="text-accent" style="text-decoration: none;">
            ← Browse all posts
          </a>
        </p>
      </div>
    </article>
  </main>
</BaseLayout>
