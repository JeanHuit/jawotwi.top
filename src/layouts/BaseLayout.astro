---
import "../styles/global.css";
import SkipLink from "../components/SkipLink.astro";
import Analytics from "../components/Analytics.astro";

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b0b0d" />
  <title>{title ? `${title} | John Awotwi` : 'John Awotwi'}</title>
  <meta name="description" content={description || 'John Awotwi - Senior Technical Officer at CSIR-INSTI. Community Development · IT Specialist · Information Security'} />
  
  <!-- Preconnect to external resources -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  
  <!-- Preload critical assets -->
  <link rel="preload" href="/moi.png" as="image" />
  
  <!-- Analytics -->
  <Analytics />
</head>
<body class="dark-theme">
  <SkipLink />
  <div id="view-transition-container">
    <slot />
  </div>
</body>
</html>
