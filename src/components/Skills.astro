---
// Skills component - Display skills and tools as badges
const skills = [
  { name: 'PHP', category: 'dev' },
  { name: 'Python', category: 'dev' },
  { name: 'MariaDB', category: 'dev' },
  { name: 'Linux', category: 'ops' },
  { name: 'Git', category: 'ops' },
  { name: 'CI/CD', category: 'ops' },
  { name: 'Proxmox', category: 'ops' },
  { name: 'Docker', category: 'ops' },
  { name: 'AWS', category: 'cloud' },
  { name: 'Infrastructure', category: 'ops' },
];
---

<div class="skills-container">
  {skills.map((skill) => (
    <span class={`skill-badge ${skill.category}`}>{skill.name}</span>
  ))}
</div>

<style>
  .skills-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 9999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text);
    transition: all var(--transition);
  }

  .skill-badge:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .skill-badge.dev {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.3);
  }

  .skill-badge.ops {
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.3);
  }

  .skill-badge.cloud {
    background: rgba(168, 85, 247, 0.1);
    border-color: rgba(168, 85, 247, 0.3);
  }
</style>
