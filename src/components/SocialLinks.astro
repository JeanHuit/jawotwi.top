---
// SocialLinks component
interface SocialLink {
  name: string;
  url: string;
}

const defaultLinks: SocialLink[] = [
  { name: 'Twitter', url: 'https://twitter.com/JeanHuit' },
  { name: 'GitHub', url: 'https://github.com/JeanHuit' },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/johnawotwi/' },
];

const { links = defaultLinks } = Astro.props;
---

<div class="social-links">
  <img src="/moi.png" alt="John Awotwi" width="42" height="42" />
  {links.map((link) => (
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
    >
      {link.name}
    </a>
  ))}
</div>

<style>
  .social-links {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .social-links a {
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
  }

  .social-links a:hover {
    color: var(--accent);
  }
</style>
