---
// SEO component - Handles meta tags and structured data
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  section?: string;
  tags?: string[];
  keywords?: string[];
  canonicalUrl?: string;
}

const {
  title,
  description,
  image = '/moi.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'John Awotwi',
  section,
  tags = [],
  keywords = [],
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://jawotwi.top';
const fullCanonicalUrl = canonicalUrl || siteUrl + Astro.url.pathname;
const fullImageUrl = image.startsWith('http') ? image : siteUrl + image;
---

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={author} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullCanonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:site_name" content="John Awotwi" />
{publishedTime && (
  <meta property="article:published_time" content={typeof publishedTime === 'string' ? publishedTime : publishedTime.toISOString()} />
)}
{modifiedTime && (
  <meta property="article:modified_time" content={typeof modifiedTime === 'string' ? modifiedTime : modifiedTime.toISOString()} />
)}
{author && <meta property="article:author" content={author} />}
{section && <meta property="article:section" content={section} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullCanonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:creator" content="@JeanHuit" />

<!-- Canonical URL -->
<link rel="canonical" href={fullCanonicalUrl} />

<!-- JSON-LD Structured Data -->
{type === 'article' ? (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: description,
    image: fullImageUrl,
    author: {
      '@type': 'Person',
      name: author,
      url: siteUrl,
    },
    publisher: {
      '@type': 'Person',
      name: 'John Awotwi',
    },
    datePublished: publishedTime ? (typeof publishedTime === 'string' ? publishedTime : publishedTime.toISOString()) : undefined,
    dateModified: modifiedTime ? (typeof modifiedTime === 'string' ? modifiedTime : modifiedTime.toISOString()) : undefined,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': fullCanonicalUrl,
    },
    keywords: keywords.join(', '),
    articleSection: section,
    articleTag: tags,
  })} />
) : (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'John Awotwi',
    url: siteUrl,
    image: fullImageUrl,
    sameAs: [
      'https://twitter.com/JeanHuit',
      'https://github.com/JeanHuit',
      'https://www.linkedin.com/in/johnawotwi/',
    ],
    jobTitle: 'Senior Technical Officer',
    worksFor: {
      '@type': 'Organization',
      name: 'CSIR-INSTI',
    },
    description: 'Community Development · IT Specialist · Information Security',
  })} />
)}
