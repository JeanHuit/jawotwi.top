---

{icons[name] ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class={`icon ${className}`}
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    width={size}
    height={size}
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d={icons[name]} />
  </svg>
) : (
  <span class="icon-placeholder" aria-hidden="true">?</span>
)}

<style>
  .icon {
    display: inline-block;
    vertical-align: middle;
  }

  .icon-placeholder {
    display: inline-block;
    width: 1em;
    height: 1em;
    text-align: center;
    color: var(--muted);
  }
</style>
