---
// ExpandableCard component - Expands on hover to reveal more content
interface Props {
  title: string;
  description: string;
  details?: string[];
  ctaText?: string;
  ctaHref?: string;
  class?: string;
}

const { title, description, details = [], ctaText = 'Get Started', ctaHref = '/?section=services', class: className = '' } = Astro.props;
---

<div class={`expandable-card ${className}`}>
  <div class="card-main">
    <div class="card-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
      </svg>
    </div>
    <h3>{title}</h3>
    <p class="short-desc">{description}</p>
  </div>
  
  <div class="card-expanded">
    {details.length > 0 && (
      <ul class="details-list">
        {details.map((detail) => (
          <li>{detail}</li>
        ))}
      </ul>
    )}
    <a href={ctaHref} class="cta-button">{ctaText}</a>
  </div>
</div>

<style>
  .expandable-card {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 0;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .expandable-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .expandable-card:hover::before {
    transform: scaleX(1);
  }

  .card-main {
    transition: transform 0.4s ease;
  }

  .expandable-card:hover .card-main {
    transform: translateY(-5px);
  }

  .card-icon {
    width: 48px;
    height: 48px;
    background: rgba(167, 139, 250, 0.1);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    border: 1px solid rgba(167, 139, 250, 0.2);
    transition: var(--transition);
  }

  .expandable-card:hover .card-icon {
    background: var(--accent);
    border-color: var(--accent);
  }

  .expandable-card:hover .card-icon svg {
    color: white;
  }

  .card-icon svg {
    width: 24px;
    height: 24px;
    color: var(--accent);
    transition: var(--transition);
  }

  .card-main h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .short-desc {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .card-expanded {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateY(10px);
  }

  .expandable-card:hover .card-expanded {
    max-height: 300px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--panel-border);
  }

  .details-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }

  .details-list li {
    padding: 0.5rem 0;
    color: var(--muted);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .details-list li::before {
    content: '▹';
    color: var(--accent);
    font-size: 1rem;
  }

  .cta-button {
    display: inline-block;
    background: var(--accent);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: var(--transition);
    border: 1px solid transparent;
  }

  .cta-button:hover {
    background: transparent;
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
</style>
