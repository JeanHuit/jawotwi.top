# Analytics Configuration
# Uncomment and configure the analytics provider you want to use

# Plausible Analytics (privacy-friendly)
# PUBLIC_ANALYTICS_PROVIDER=plausible
# PUBLIC_ANALYTICS_ID=jawotwi.top

# Google Analytics
# PUBLIC_ANALYTICS_PROVIDER=google
# PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Umami Analytics
# PUBLIC_ANALYTICS_PROVIDER=umami
# PUBLIC_ANALYTICS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Site Configuration
PUBLIC_SITE_URL=https://jawotwi.top
